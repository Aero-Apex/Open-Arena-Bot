# ──────────────────────────────────────────────
# 🏟️  OPEN ARENA BOT — Environment Variables
# ──────────────────────────────────────────────

# === Discord (REQUIRED) ===
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_server_id_here

# === NVIDIA Nemotron (REQUIRED) ===
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# === SearXNG (optional, has default) ===
SEARXNG_URL=http://192.168.88.32:8080/search

# === Status Monitor (optional) ===
STATUS_URL=https://openarena.eu.cc/

# === Anti-Captcha Solvers (for EaseMate.ai GPT-5.5) ===
# At least one required to use /ask model=EaseMate GPT-5.5
ANTICAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

# === EaseMate.ai Session ===
EASEMATE_SESSION_DIR=./sessions

# === Debug ===
DEBUG=false
